# Ported from ~/.config/kitty/kitty.conf

# --- Font ---
font-family = Berkeley Mono
#font-family = Ioskeley Mono Term
font-size = 15
font-style = Retina SemiCondensed
font-style-bold = Bold SemiCondensed
font-style-italic = Retina SemiCondensed Oblique
font-style-bold-italic = Bold SemiCondensed Oblique
# Nerd Font icons from the non-Mono font so they render full size (kitty symbol_map)
# font-codepoint-map = U+E000-U+F8FF,U+F0000-U+F1AFF=FiraCode Nerd Font
# Ligatures are on by default (kitty: disable_ligatures never)

# --- Theme: Solarized Osaka, same palette as kitty (themes/solarized-osaka) ---
# eza and starship follow this palette; nvim uses solarized-osaka.nvim with a transparent background
theme = solarized-osaka
background-opacity = 0.8

# --- Clipboard ---
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# --- Window ---
window-padding-x = 10
window-padding-y = 10
window-save-state = always

# ~100k lines; Ghostty sizes scrollback in bytes, not lines
scrollback-limit = 100000000

# --- Bell: no sound ---
bell-features = no-audio,no-system

# --- Keybinds ---
# kitty ctrl+f opened fzf over scrollback; closest native equivalent is search
keybind = ctrl+f=start_search

# --- Scrolling ---
# Slow touchpad (precision) scrolling; mouse wheel (discrete) stays at default
mouse-scroll-multiplier = precision:0.4,discrete:3
