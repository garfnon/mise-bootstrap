# Linuxbrew packages for Debian/Ubuntu, applied by `mise run brew` after the
# Aptfile. Same split as macOS: everything except the version-pinned tools in
# home/.config/mise/config.toml, minus what the Aptfile already covers -- the
# GNU userland and casks in the macOS Brewfile don't belong here.
#
# Regenerate the formula list with:  brew leaves

# CLI tools -- keep in sync with the macOS Brewfile
brew "bat"            # cat with syntax highlighting
brew "bitwarden-cli"  # bw
brew "bottom"         # btm
brew "direnv"
brew "dust"           # du
brew "eza"            # `ll` alias
brew "fastfetch"
brew "fd"             # find
brew "fzf"
brew "git-delta"      # git pager, see home/.gitconfig
brew "jq"
brew "k9s"
brew "kind"
brew "kubelogin"      # kubectl oidc-login
brew "minikube"
brew "ouch"           # compress/decompress any archive format
brew "neovim"
brew "ripgrep"        # rg
brew "sd"             # sed
brew "sevenzip"       # 7zz
brew "sops"
brew "tmux"
brew "tokei"          # `gcloc` alias
brew "uv"
brew "viddy"          # `watch` alias
brew "yamllint"
brew "zoxide"         # `z`, via the oh-my-zsh plugin

# coreutils and findutils, Rust rewrites -- same as the macOS Brewfile. Each is
# skipped once the distro's own is already uutils (Ubuntu 25.10+ bases ship
# uutils coreutils); Zorin 18 still ships GNU for both.
brew "uutils-coreutils" unless `/usr/bin/ls --version 2>/dev/null`.include?("uutils")
brew "uutils-findutils" unless `/usr/bin/find --version 2>/dev/null`.include?("(Rust)")
