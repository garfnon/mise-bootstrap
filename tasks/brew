#!/usr/bin/env bash
#MISE description="Install system packages: the Brewfile on macOS, the Aptfile + Brewfile.linux on Debian/Ubuntu"
source "$(dirname "$0")/lib.sh"

if is_linux; then
  have apt-get || die "only Debian/Ubuntu (apt) is supported on Linux"
  info "apt packages from Aptfile"
  mapfile -t pkgs < <(sed 's/#.*//' "$ROOT/Aptfile" | awk 'NF {print $1}')
  as_root apt-get update -qq
  as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}"
  ok "${#pkgs[@]} packages installed"

  if have starship; then
    skip "starship (already installed)"
  else
    info "starship"
    mkdir -p "$HOME/.local/bin"
    curl -fsSL https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin" >/dev/null
    ok "starship -> ~/.local/bin"
  fi

  # Homebrew is installed by bootstrap.sh; it can't be installed as root, so it's optional here
  [ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  have brew || { skip "Brewfile.linux (Homebrew not installed)"; exit 0; }
elif ! have brew; then
  info "Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

info "brew bundle ($(basename "$BREWFILE"))"
brew bundle --file="$BREWFILE" --no-lock
ok "$(basename "$BREWFILE") applied"

info "Drift check (installed leaves not in $(basename "$BREWFILE"))"
comm -13 \
  <(grep -oE '^brew "[^"]+"' "$BREWFILE" | cut -d'"' -f2 | sort) \
  <(brew leaves | sort) | while read -r p; do warn "$p installed but not in $(basename "$BREWFILE")"; done
exit 0
