#!/usr/bin/env bash
#MISE description="Regenerate this OS's Brewfile from what is actually installed"
source "$(dirname "$0")/lib.sh"

have brew || die "brew not found"

# Dotfiles need no snapshot: home/ is symlinked into $HOME, so edits to
# ~/.zshrc are edits to this repo. Only the package lists can drift.
bf="$(basename "$BREWFILE")"
info "Rebuilding $bf from installed leaves + casks"
{
  sed -n '1,/^# Regenerate/p' "$BREWFILE"
  echo
  brew leaves | sed 's/^/brew "/; s/$/"/'
  if is_mac; then
    echo
    brew list --cask | sed 's/^/cask "/; s/$/"/'
  fi
} > "$BREWFILE.new"
mv "$BREWFILE.new" "$BREWFILE"
ok "$bf rewritten -- review the diff, the section comments were dropped"
git -C "$ROOT" diff --stat -- "$bf"
